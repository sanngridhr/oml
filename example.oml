let категорія (темп : float) : atom =
  if темп <. 0. then #мороз
  else if темп <. 20. then #помірно
  else #спека ;;

let описати (темп : float) : (float, string) =
  match категорія темп
  | #мороз   => (темп, "нижче нуля")
  | #помірно => (темп, "комфортна погода")
  | _        => (темп, "занадто спекотно") ;;

let rec map (ф : 'a -> 'b) (елементи : 'a list) : 'b list =
  match елементи
  | []              => []
  | голова :: хвіст => ф голова :: map ф хвіст ;;

let rec температури (записи : (string, float) dict list) : float list =
  match записи
  | []                          => []
  | { "temp" => темп } :: решта => темп :: температури решта
  | _ :: решта                  => температури решта ;;

let у-фаренгейти (запис : (string, float) dict) : (string, float) dict =
  match запис
  | { "temp" => темп, .. інші } => { "temp" => темп *. 1.8 +. 32., .. інші }
  | _                           => запис ;;

(* Симульовані дані із зовнішнього API чи пристрою *)
let виміри : (string, float) dict list =
  [ { "temp" => -3.5, "humidity" => .8 },
    { "humidity" => .55 },
    { "temp" => 4.25 },
    { "temp" => 27.5, "humidity" => .3 } ] ;;

(* Виписує спочатку результати в градусах Цельсія із описом, а тоді в градусах Фаренгейта *)
let () =
  ignore $ map
    (fun пара ->
       match пара
       | (темп, опис) => print-line $ float->string темп ^ " °C: " ^ опис)
    (map описати $ температури виміри) ;;

let () = print-line "Фаренгейти: ;; (* Перевірка на неправильний токен *)
let _ = -199999999999999999999999 ;;

let () =
  ignore $ map
    (fun темп -> print-line $ float->string темп ^ " °F")
    (температури $ map у-фаренгейти виміри) ;;